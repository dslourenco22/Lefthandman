# Copy to .env and adjust before deploying.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=omni
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=resume_ranker

# --- Backend ---
# In docker-compose this is derived from the Postgres vars above; set it
# directly only if running the backend outside compose.
# DATABASE_URL=postgresql+psycopg2://omni:change_this_strong_password@localhost:5432/resume_ranker

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_long_random_string

# First-run admin account (created only if the users table is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@omnicontrol.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
